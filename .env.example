# TechSpace BuildLab '26 Discord Bot Configuration
# Copy this file to .env and fill in your values. Never commit .env to source control!

# ============================================================
# REQUIRED: Discord Bot Credentials
# ============================================================
# Bot token from Discord Developer Portal (Applications > Bot > Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Target Server Guild ID (Right-click server in Discord > Copy Server ID)
GUILD_ID=your_discord_guild_id_here

# Optional: Application Client ID (Defaults to client.user.id if omitted)
CLIENT_ID=optional_bot_application_client_id

# ============================================================
# NETWORKING & HOSTING CONFIGURATION
# ============================================================
# Primary port for GitHub Webhook & Health check endpoints
# On Bot-Hosting.net or cloud hosts, set to the assigned port or $PORT
PORT=3000

# Secondary fallback port for webhook server (used if PORT is unset)
GITHUB_WEBHOOK_PORT=3000

# Optional: Public URL of the bot host (e.g. https://your-server.bot-hosting.net)
# Used when providing external GitHub Webhook payload URLs: ${PUBLIC_URL}/api/github/webhook
PUBLIC_URL=https://your-bot-host-domain.example.com

# ============================================================
# DATABASE STORAGE
# ============================================================
# Path to SQLite database file (directory will be created automatically if missing)
DATABASE_PATH=data/buildlab.sqlite

# ============================================================
# GITHUB INTEGRATION (Optional)
# ============================================================
# Optional personal access token for GitHub API queries
GITHUB_TOKEN=optional_github_personal_access_token

# GitHub organization or username owning the project repositories
GITHUB_ORG=techspace-srm

# Secret token configured in GitHub Webhook settings for HMAC SHA-256 verification
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Activity health thresholds (in days)
GITHUB_ACTIVE_DAYS=2
GITHUB_LOW_ACTIVITY_DAYS=4
GITHUB_AT_RISK_DAYS=7

# ============================================================
# SUPPORT TICKET SYSTEM (Optional overrides)
# ============================================================
TICKET_CATEGORY_NAME=🎫 TICKETS
TICKET_ARCHIVE_CATEGORY_NAME=📁 CLOSED TICKETS
